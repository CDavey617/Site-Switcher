<ResourceDictionary x:Class="CraigDavey.Nina.Sites.Features.Dock.Resources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="CraigDavey.Nina.Sites.Features.Dock.SitesPanel_Dockable">
        <StackPanel Margin="8">
            <TextBlock Text="Site Switcher" FontWeight="Bold" />
            <ComboBox Margin="0,6,0,0"
                      ItemsSource="{Binding Sites}"
                      SelectedItem="{Binding SelectedSite}"
                      DisplayMemberPath="Name" />
            <Button Margin="0,6,0,0" Content="Apply to active profile" Command="{Binding ApplyCommand}" />
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding CurrentLocation}" />
            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding StatusMessage}" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
