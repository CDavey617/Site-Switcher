<ResourceDictionary x:Class="CraigDavey.Nina.Sites.Features.Settings.Resources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="OptionsTemplate">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <TextBlock Text="Save sites and switch between them" FontSize="14" FontWeight="Bold" />
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Selecting a site updates the latitude, longitude and elevation of the active NINA profile. The chosen site is remembered for that profile." />

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ListBox Grid.Column="0" Height="150"
                             ItemsSource="{Binding Settings.Sites}"
                             SelectedItem="{Binding Settings.SelectedSite}"
                             DisplayMemberPath="Name" />
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <Button Content="New site" Command="{Binding Settings.NewSiteCommand}" MinWidth="120" Margin="0,0,0,4" />
                        <Button Content="Use current profile location" Command="{Binding Settings.UseCurrentLocationCommand}" MinWidth="120" Margin="0,0,0,4" />
                        <Button Content="Apply selected site" Command="{Binding Settings.ApplySiteCommand}" MinWidth="120" Margin="0,0,0,4" />
                        <Button Content="Delete selected site" Command="{Binding Settings.DeleteSiteCommand}" MinWidth="120" />
                    </StackPanel>
                </Grid>

                <GroupBox Header="Site details" Margin="0,10,0,0">
                    <Grid Margin="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,4" Text="Name" />
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,4"
                                 Text="{Binding Settings.EditingSite.Name, ValidatesOnExceptions=True}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,4" Text="Latitude" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,4"
                                 Text="{Binding Settings.EditingSite.Latitude, ValidatesOnExceptions=True}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,4" Text="Longitude" />
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,4"
                                 Text="{Binding Settings.EditingSite.Longitude, ValidatesOnExceptions=True}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,4" Text="Elevation (m)" />
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,4"
                                 Text="{Binding Settings.EditingSite.Elevation, ValidatesOnExceptions=True}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,4" Text="Notes" />
                        <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,4"
                                 Text="{Binding Settings.EditingSite.Notes}" />
                    </Grid>
                </GroupBox>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Save site" Command="{Binding Settings.SaveSiteCommand}" MinWidth="100" />
                </StackPanel>

                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding Settings.CurrentLocation}" />
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Settings.StatusMessage}" />
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
